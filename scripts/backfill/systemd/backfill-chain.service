[Unit]
Description=approved_hold enrichment backfill — runs batches back-to-back until the pool drains
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=casey
WorkingDirectory=/home/casey/repos/youtube-outreach-orchestrator-v1
Environment=HOME=/home/casey
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env bash /home/casey/repos/youtube-outreach-orchestrator-v1/scripts/backfill/chain.sh
# Added 2026-08-09: an interactive-session-backgrounded chain.sh kept getting
# reaped (once at ~30s, once at ~26h, once almost immediately) independent of
# any real failure in the script itself — background tasks tied to a Claude Code
# session aren't durable across the session's own lifecycle. A systemd unit
# (same pattern as enrichment-db-cleanup.timer / autopilot-campaign.service)
# runs it outside that lifecycle entirely.
#
# on-failure (not always): chain.sh itself exits 0 cleanly on halt.flag or a
# drained pool (touches chain-done.flag) — those should stay stopped, not spin.
# A crash/kill (nonzero) restarts. Resume after halting with:
#   rm logs/backfill-2026-07/halt.flag && sudo systemctl restart backfill-chain
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
