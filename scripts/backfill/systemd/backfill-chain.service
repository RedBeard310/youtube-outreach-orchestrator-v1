[Unit]
Description=approved_hold enrichment backfill — runs batches back-to-back until the pool drains
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=casey
WorkingDirectory=/home/casey/repos/youtube-outreach-orchestrator-v1
Environment=HOME=/home/casey
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env bash /home/casey/repos/youtube-outreach-orchestrator-v1/scripts/backfill/chain.sh
# Added 2026-08-09: an interactive-session-backgrounded chain.sh kept getting
# reaped (once at ~30s, once at ~26h, once almost immediately) independent of
# any real failure in the script itself — background tasks tied to a Claude Code
# session aren't durable across the session's own lifecycle. A systemd unit
# (same pattern as enrichment-db-cleanup.timer / autopilot-campaign.service)
# runs it outside that lifecycle entirely.
#
# Restart=always (not on-failure): chain.sh's own flock (scripts/backfill/chain.sh,
# 2026-08-09) makes exit-0 ambiguous between three cases — halt.flag, a drained
# pool, AND "another instance already holds the lock." An interactively-launched
# chain.sh is expected to hold the lock most of the time; this unit should keep
# retrying every 60s so it's already waiting and picks up instantly the moment
# that lock is free (session death, drained pool, whatever) — not just on crash.
# halt.flag still stops it for real (exits 0, retries, sees the flag, exits 0
# again — harmless spin at 60s intervals). Resume after halting with:
#   rm logs/backfill-2026-07/halt.flag && sudo systemctl restart backfill-chain
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
