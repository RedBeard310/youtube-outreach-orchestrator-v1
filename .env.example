# Airtable
AIRTABLE_PAT=
LEAD_BASE_ID=appenY7r5jlZMRpJ0
LEAD_TABLE_NAME=lead_candidates

# Absolute paths to the repos the orchestrator shells out to.
# All three must be `npm install`'d and runnable on their own before the orchestrator can drive them.
EMAIL_OUTREACH_REPO_PATH=
DEEP_RESEARCH_REPO_PATH=
LEAD_FINDER_REPO_PATH=

# Lead-finder auto-run mode. Default: off.
# - false (default): the every-4h tick never fires the finder. Trigger it
#                    manually with `npm run finder`.
# - true:            the tick fires the finder once every LEAD_FINDER_INTERVAL_HOURS.
# State tracked in logs/lead-finder-state.json regardless of mode.
LEAD_FINDER_AUTO=false
LEAD_FINDER_INTERVAL_HOURS=24

# Concurrency passed to the approved-path driver. Default: 4.
APPROVED_CONCURRENCY=4

# Default --business-model passed to youtube-deep-research-v1's run-channel.ts
# for D100 leads (lead_candidates has no per-lead business_model field).
# Allowed: high_ticket_service, saas, info_product, coaching, agency, other.
D100_BUSINESS_MODEL=high_ticket_service

# Seconds to sleep between consecutive step-B (deep research) invocations,
# to stay under YouTube's 10 searches/min/project quota. Set to 0 to disable.
D100_STEP_B_DELAY_SECONDS=60
